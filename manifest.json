{
  "manifest_version": 3,
  "name": "Tool for Avito",
  "version": "1.0.0",
  "description": "Инструмент аналитики цен и экспорта объявлений в Markdown, JSON и TSV для личного анализа. Неофициальное расширение.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tool-for-avito@topmob.addon",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://www.avito.ru/*",
    "*://avito.ru/*",
    "*://m.avito.ru/*"
  ],
  "background": {
    "scripts": [
      "background/service-worker.js"
    ],
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Tool for Avito"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.avito.ru/*",
        "*://avito.ru/*",
        "*://m.avito.ru/*"
      ],
      "js": [
        "shared/parser.js",
        "content/content.js"
      ],
      "css": [],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/content.css"
      ],
      "matches": [
        "*://www.avito.ru/*",
        "*://avito.ru/*",
        "*://m.avito.ru/*"
      ]
    }
  ]
}